# Copy this file to .env and fill in your values. Never commit .env.
# Local development (no setup needed): SQLite file
DATABASE_URL=sqlite:///./sankalp.db
# Supabase example (Project Settings > Database > Connection string > URI):
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# IMPORTANT: change this to a long random string before real use.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-your-own-env-file
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Code judge ----
# "local" = runs code on your own computer (NOT SAFE, development only, needs gcc/g++/python/javac installed)
# "judge0" = real sandbox (use this on the server)
JUDGE_BACKEND=local
JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=put-the-same-token-you-set-in-judge0.conf
